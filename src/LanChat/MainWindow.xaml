<Window x:Class="LanChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LanChat.Models"
        Title="LAN Chat" Height="680" Width="980" MinHeight="480" MinWidth="720"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ==================== ЭКРАН ПОДКЛЮЧЕНИЯ ==================== -->
        <Grid x:Name="ConnectView">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="28,26">
                <StackPanel>

                    <TextBlock Text="LAN Chat" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{DynamicResource Str_app_subtitle}"
                               FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,22"/>

                    <TextBlock Text="{DynamicResource Str_your_name_label}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,6"/>
                    <TextBox x:Name="NickBox" Style="{StaticResource InputBox}"
                             Tag="{DynamicResource Str_nick_placeholder}" MaxLength="24"
                             KeyDown="NickBox_KeyDown"/>

                    <TextBlock Text="{DynamicResource Str_chats_in_network_label}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimBrush}" Margin="2,22,0,6"/>

                    <Grid MinHeight="96">
                        <Border x:Name="SearchHint" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="12,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_searching_hint}" FontSize="13"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_searching_hint2}"
                                           FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                           Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="ServerList" Style="{StaticResource CardListBox}"
                                 MaxHeight="190" Visibility="Collapsed"
                                 SelectionChanged="ServerList_SelectionChanged"
                                 MouseDoubleClick="ServerList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DiscoveredServer}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Button x:Name="JoinButton" Content="{DynamicResource Str_join_button}" Style="{StaticResource PrimaryButton}"
                            Margin="0,14,0,0" IsEnabled="False" Click="JoinButton_Click"/>

                    <Grid Margin="0,16,0,16">
                        <Border Height="1" Background="{DynamicResource BorderBrush2}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SurfaceBrush}" Padding="10,0" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_or_divider}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                    </Grid>

                    <Button x:Name="HostButton" Content="{DynamicResource Str_host_button}" Style="{StaticResource GhostButton}"
                            Click="HostButton_Click"/>

                    <Expander Margin="0,14,0,0" Foreground="{DynamicResource TextDimBrush}" FontSize="12">
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource Str_manual_ip_header}" FontSize="12"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </Expander.Header>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManualIpBox" Grid.Column="0" Style="{StaticResource InputBox}"
                                     Tag="192.168.1.10" KeyDown="ManualIpBox_KeyDown"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_manual_connect_button}" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="ManualConnect_Click"/>
                        </Grid>
                    </Expander>

                    <CheckBox x:Name="AutoStartCheckBox" Content="{DynamicResource Str_autostart_label}"
                              Foreground="{DynamicResource TextDimBrush}" FontSize="12"
                              Margin="2,16,0,0" Click="AutoStartCheckBox_Click"/>

                    <TextBlock x:Name="ConnectError" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== ЭКРАН ЧАТА ==================== -->
        <Grid x:Name="ChatView" Visibility="Collapsed" AllowDrop="True"
              DragEnter="ChatView_DragEnter" DragOver="ChatView_DragEnter"
              DragLeave="ChatView_DragLeave" Drop="ChatView_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="RoomTitle" Text="Чат" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource OnlineBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TypingText" Text="" FontSize="11" Margin="8,0,0,0" FontStyle="Italic"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0">
                        <Button Content="{DynamicResource Str_clear_button}" Style="{StaticResource GhostButton}" Padding="14,6"
                                Margin="0,0,8,0" Click="ClearButton_Click"/>
                        <Button Content="{DynamicResource Str_leave_button}" Style="{StaticResource GhostButton}" Padding="14,6"
                                Click="LeaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Лента сообщений -->
            <ScrollViewer x:Name="MessageScroll" Grid.Row="1" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto" Padding="10,12,6,12">
                <ItemsControl x:Name="MessageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ChatMessage}">
                            <Grid Margin="8,2">

                                <TextBlock Text="{Binding Text}" FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           HorizontalAlignment="Center" Margin="0,8"
                                           Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"/>

                                <Border x:Name="Bubble" CornerRadius="12" Padding="12,8" MaxWidth="460"
                                        Background="{DynamicResource BubbleOtherBrush}"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsNormal, Converter={StaticResource BoolToVis}}">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource Str_edit_menu}" Click="EditMessage_Click">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsMine}" Value="True"/>
                                                                    <Condition Binding="{Binding HasFile}" Value="False"/>
                                                                    <Condition Binding="{Binding IsDeleted}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Str_delete_menu}" Click="DeleteMessage_Click">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsMine}" Value="True"/>
                                                                    <Condition Binding="{Binding IsDeleted}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock x:Name="NickLine" Text="{Binding Nick}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,0,3"/>

                                        <TextBlock x:Name="TextLine" Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>

                                        <Border x:Name="FileChip" Background="{DynamicResource ChipOverlayBrush}" CornerRadius="8"
                                                Padding="8,6" Cursor="Hand" Visibility="Collapsed"
                                                MouseLeftButtonUp="FileChip_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📎" FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Margin="8,0,0,0">
                                                    <TextBlock x:Name="FileNameLine" Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" MaxWidth="260"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="FileSizeLine" Text="{Binding FileSizeText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextDimBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="DeletedLine" Text="{DynamicResource Str_deleted_text}" FontStyle="Italic"
                                                   FontSize="13" Foreground="{DynamicResource TextDimBrush}"
                                                   Visibility="Collapsed"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,3,0,0">
                                            <TextBlock x:Name="EditedMark" Text="{DynamicResource Str_edited_mark}" FontSize="10" Opacity="0.65"
                                                       Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TimeLine" Text="{Binding TimeText}" FontSize="10" Opacity="0.65"
                                                       Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock x:Name="TickMark" Text="{Binding TickGlyph}" FontSize="10" Margin="4,0,0,0"
                                                       Foreground="White" Opacity="0.6" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource BubbleMineBrush}"/>
                                    <Setter TargetName="NickLine" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TickMark" Property="Visibility" Value="Visible"/>
                                    <!-- Пузырь "моё" всегда синий вне зависимости от темы — текст внутри фиксированно светлый -->
                                    <Setter TargetName="TextLine" Property="Foreground" Value="White"/>
                                    <Setter TargetName="EditedMark" Property="Foreground" Value="#CCFFFFFF"/>
                                    <Setter TargetName="TimeLine" Property="Foreground" Value="#CCFFFFFF"/>
                                    <Setter TargetName="DeletedLine" Property="Foreground" Value="#CCFFFFFF"/>
                                    <Setter TargetName="FileChip" Property="Background" Value="#20FFFFFF"/>
                                    <Setter TargetName="FileNameLine" Property="Foreground" Value="White"/>
                                    <Setter TargetName="FileSizeLine" Property="Foreground" Value="#CCFFFFFF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFile}" Value="True">
                                    <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="FileChip" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                    <Setter TargetName="EditedMark" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                    <Setter TargetName="TickMark" Property="Opacity" Value="0.85"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                    <Setter TargetName="TickMark" Property="Opacity" Value="1"/>
                                    <Setter TargetName="TickMark" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                    <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="FileChip" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="EditedMark" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TickMark" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="DeletedLine" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Диалоги: общий чат + личные переписки с участниками -->
            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0" Padding="10,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_dialogs_label}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}"
                               Margin="4,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ConversationList" Style="{StaticResource ConversationListBox}"
                                 SelectionChanged="ConversationList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConversationItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource OnlineBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource TextDimBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}"
                                                CornerRadius="8" Padding="6,1" MinWidth="16"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Unread}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Ввод -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel>
                    <Grid x:Name="EditBar" Margin="2,0,2,8" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Str_editing_label}" FontSize="11.5"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_cancel_edit}" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}"
                                   HorizontalAlignment="Right" Cursor="Hand"
                                   MouseLeftButtonUp="CancelEdit_Click" TextDecorations="Underline"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EmojiButton" Grid.Column="0" Content="🙂" Style="{StaticResource GhostButton}"
                                Padding="14,9" Margin="0,0,8,0" ToolTip="{DynamicResource Str_emoji_tooltip}"
                                Click="EmojiButton_Click"/>
                        <Button x:Name="AttachButton" Grid.Column="1" Content="📎" Style="{StaticResource GhostButton}"
                                Padding="14,9" Margin="0,0,10,0" ToolTip="{DynamicResource Str_attach_tooltip}"
                                Click="AttachButton_Click"/>
                        <TextBox x:Name="InputBox" Grid.Column="2" Style="{StaticResource InputBox}"
                                 Tag="{DynamicResource Str_input_placeholder}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                                 MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>
                        <Button Grid.Column="3" Content="{DynamicResource Str_send_button}" Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" Click="SendButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Эмодзи-пикер -->
            <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="10" Padding="8" MaxWidth="260">
                    <Border.Resources>
                        <Style x:Key="EmojiBtn" TargetType="Button">
                            <Setter Property="FontSize" Value="19"/>
                            <Setter Property="Width" Value="34"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <WrapPanel Width="240">
                        <Button Content="😀" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😂" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😍" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🙂" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😉" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😎" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🤔" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🙄" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😢" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😭" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😡" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😱" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🥳" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😴" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🤗" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="😅" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="👍" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="👎" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="👏" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🙏" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🤝" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="💪" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="✌️" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="👋" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="❤️" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🔥" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🎉" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="✅" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="❌" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="💯" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="⭐" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                        <Button Content="🫡" Style="{StaticResource EmojiBtn}" Click="EmojiPick_Click"/>
                    </WrapPanel>
                </Border>
            </Popup>

            <!-- Подсказка при перетаскивании файла из проводника — поверх всего, сама мышь не ловит -->
            <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#CC12141A" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2" CornerRadius="14" Padding="34,26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="📎" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_drop_hint}" FontSize="14"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ==================== Тема / язык / о программе — поверх обоих экранов ==================== -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
            <Button x:Name="ThemeToggleButton" Content="🌙" Style="{StaticResource GhostButton}" Padding="10,6"
                    Margin="0,0,8,0" ToolTip="Light/Dark" Click="ThemeToggle_Click"/>
            <Button x:Name="LanguageToggleButton" Content="RU" Style="{StaticResource GhostButton}" Padding="10,6"
                    Margin="0,0,8,0" ToolTip="ru / en / tk" Click="LanguageToggle_Click"/>
            <Button Content="ℹ️" Style="{StaticResource GhostButton}" Padding="10,6"
                    ToolTip="{DynamicResource Str_about_title}" Click="AboutButton_Click"/>
        </StackPanel>

        <!-- ==================== О программе ==================== -->
        <Border x:Name="AboutOverlay" Background="#CC12141A" Visibility="Collapsed"
                MouseLeftButtonUp="AboutOverlay_Click">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="14" Padding="28,24" Width="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonUp="AboutCard_Click">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Str_about_title}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextDimBrush}"
                                   HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonUp="AboutOverlay_Click"/>
                    </Grid>

                    <Border Width="96" Height="96" CornerRadius="48" Margin="0,18,0,10" HorizontalAlignment="Center"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush x:Name="AuthorPhotoBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="Anvar Sharipov" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_about_role}" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="{DynamicResource Str_about_tagline}" FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                    <StackPanel Margin="0,18,0,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str_about_mobile}" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Text="+993 61 30 43 56" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str_about_home}" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
